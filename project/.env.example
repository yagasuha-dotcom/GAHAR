# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit file .env ke GitHub!

# Connection string PostgreSQL. Rekomendasi: Neon (neon.tech) — gratis, serverless, cocok untuk Vercel.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret key untuk JWT session (boleh string acak apapun, minimal 32 karakter)
AUTH_SECRET=ganti_dengan_string_rahasia_yang_panjang_dan_acak
